{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/vDevPreview/MicrosoftTeams.schema.json",
  "manifestVersion": "devPreview",
  "id": "6d3b8a41-2f5c-4e7a-9b0d-1c2e3f4a5b6c",
  "version": "1.0.0",
  "name": {
    "short": "xcsh",
    "full": "xcsh — AI assistant for F5 Distributed Cloud"
  },
  "description": {
    "short": "AI assistant for F5 Distributed Cloud inside Excel, Word, and PowerPoint.",
    "full": "xcsh is an AI-powered technical coworker for F5 Distributed Cloud. It reads your open workbook, document, or presentation and answers questions about F5 XC WAF, load balancing, DNS, and network security — with live data from your spreadsheets and documents. Requires the xcsh CLI running locally (install via Homebrew)."
  },
  "developer": {
    "name": "F5 Sales Demo",
    "websiteUrl": "https://github.com/f5-sales-demo/xcsh",
    "privacyUrl": "https://f5-sales-demo.github.io/xcsh-office-pane/privacy.html",
    "termsOfUseUrl": "https://f5-sales-demo.github.io/xcsh-office-pane/terms.html"
  },
  "icons": {
    "color": "assets/color.png",
    "outline": "assets/outline.png"
  },
  "accentColor": "#ca260a",
  "localizationInfo": {
    "defaultLanguageTag": "en-us"
  },
  "validDomains": [
    "f5-sales-demo.github.io",
    "127-0-0-1.local-ip.sh"
  ],
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        { "name": "Document.ReadWrite.User", "type": "Delegated" }
      ]
    }
  },
  "extensions": [
    {
      "requirements": {
        "scopes": ["workbook", "presentation", "document"],
        "capabilities": [
          { "name": "AddinCommands", "minVersion": "1.1" }
        ]
      },
      "runtimes": [
        {
          "id": "TaskPaneRuntime",
          "type": "general",
          "code": {
            "page": "https://f5-sales-demo.github.io/xcsh-office-pane/taskpane.html"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "ShowTaskpane",
              "type": "openPage",
              "pinnable": false,
              "view": "dashboard"
            }
          ]
        }
      ],
      "ribbons": [
        {
          "contexts": ["default"],
          "tabs": [
            {
              "builtInTabId": "TabHome",
              "groups": [
                {
                  "id": "xcshGroup",
                  "label": "xcsh",
                  "icons": [
                    { "size": 16, "url": "https://f5-sales-demo.github.io/xcsh-office-pane/assets/icon-16.png" },
                    { "size": 32, "url": "https://f5-sales-demo.github.io/xcsh-office-pane/assets/icon-32.png" },
                    { "size": 80, "url": "https://f5-sales-demo.github.io/xcsh-office-pane/assets/icon-80.png" }
                  ],
                  "controls": [
                    {
                      "id": "xcshTaskpaneButton",
                      "type": "button",
                      "label": "Open xcsh",
                      "icons": [
                        { "size": 16, "url": "https://f5-sales-demo.github.io/xcsh-office-pane/assets/icon-16.png" },
                        { "size": 32, "url": "https://f5-sales-demo.github.io/xcsh-office-pane/assets/icon-32.png" },
                        { "size": 80, "url": "https://f5-sales-demo.github.io/xcsh-office-pane/assets/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "Open xcsh",
                        "description": "Open the xcsh AI assistant task pane."
                      },
                      "actionId": "ShowTaskpane"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
